# Gemini API key from Google AI Studio. Required for AI-generated replies.
GEMINI_API_KEY=replace_with_your_api_key
GEMINI_MODEL=gemini-3.8-flash
GEMINI_FALLBACK_MODEL=gemini-3.6-flash

# Optional. SQLite is used by default and creates backend/codingbodhi.db.
# For PostgreSQL, set a SQLAlchemy URL such as:
# DATABASE_URL=postgresql://username:password@localhost:5432/codingbodhi
